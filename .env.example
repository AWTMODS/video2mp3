# Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=your_bot_token_here

# Port for the web server (Optional, defaults to 3000 or platform default like Render's $PORT)
PORT=3000

# Public Webhook URL (Optional)
# If provided, the bot runs in Webhook mode.
# If omitted and not running on Render, the bot automatically runs in Polling mode.
# Example: https://your-bot-name.onrender.com or https://your-domain.com
WEBHOOK_URL=

# Secret token for webhook security (Optional)
WEBHOOK_SECRET=

# Required Telegram channel for users to join (Optional)
# Example: @your_channel (Leave blank to disable channel force-join)
REQUIRED_CHANNEL=

# Max video size in MB (Optional, default: 20 due to standard Telegram Bot API download limits)
MAX_FILE_SIZE_MB=20

# Custom caption for converted audio (Optional)
CUSTOM_CAPTION=
